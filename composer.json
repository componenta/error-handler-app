{
    "name": "componenta/error-handler-app",
    "description": "Componenta application integration for error handling and reporting",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/config": "^4.0",
        "componenta/error-handler": "^2.0",
        "componenta/path-resolver": "^1.0",
        "psr/container": "^2.0",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Error\\App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Error\\App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Error\\App\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev",
            "dev-refactor/error-handler-v2": "2.0.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest"
    },
    "prefer-stable": true
}
